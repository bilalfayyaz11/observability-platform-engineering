{
  "annotations": {
    "list": []
  },
  "description": "Advanced observability dashboard demonstrating heatmaps, histogram-derived distributions, percentiles, and system telemetry.",
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Advanced Observability Overview",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "## Advanced Grafana Panels\nHeatmaps expose changing metric distributions while histogram and percentile panels provide statistical views of synthetic HTTP telemetry."
      }
    },
    {
      "id": 2,
      "type": "heatmap",
      "title": "CPU Activity Heatmap",
      "description": "Distribution of non-idle CPU activity over time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "calculate": true,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "percent",
          "min": "0",
          "max": "100"
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "mode": "single",
          "showColorScale": true
        },
        "legend": {
          "show": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_cpu_seconds_total{mode!=\"idle\"}[5m]) * 100",
          "legendFormat": "CPU {{cpu}} {{mode}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "heatmap",
      "title": "Memory Usage Heatmap",
      "description": "Distribution of memory utilization over time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "calculate": true,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "percent",
          "min": "0",
          "max": "100"
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "mode": "single",
          "showColorScale": true
        },
        "legend": {
          "show": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "Memory Usage"
        }
      ]
    },
    {
      "id": 4,
      "type": "heatmap",
      "title": "Network Traffic Heatmap",
      "description": "Combined receive and transmit throughput distribution.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "calculate": true,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "Bps"
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "mode": "single",
          "showColorScale": true
        },
        "legend": {
          "show": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]) + rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])",
          "legendFormat": "{{device}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "heatmap",
      "title": "HTTP Request Duration Buckets",
      "description": "Prometheus classic histogram bucket activity over time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s"
        },
        "tooltip": {
          "mode": "single",
          "showColorScale": true
        },
        "legend": {
          "show": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request Duration Percentiles",
      "description": "P50, P90, P95, and P99 request duration calculated from histogram buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P95"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 7,
      "type": "histogram",
      "title": "P95 Request Latency Distribution",
      "description": "Distribution of calculated P95 latency values across the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "bucketOffset": 0,
        "combine": false,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P95 latency"
        }
      ]
    },
    {
      "id": 8,
      "type": "histogram",
      "title": "P90 Response Size Distribution",
      "description": "Distribution of calculated P90 response-size values across the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "bucketOffset": 0,
        "combine": false,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.90, sum by (le) (rate(http_response_size_bytes_bucket[5m])))",
          "legendFormat": "P90 response size"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "advanced-observability",
    "heatmap",
    "histogram",
    "prometheus",
    "percentiles"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Advanced Grafana Visualizations",
  "uid": "advanced-grafana-visualizations",
  "version": 1
}
