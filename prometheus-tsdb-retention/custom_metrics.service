[Unit]
Description=Custom Prometheus Metrics Generator
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
Type=simple
ExecStart=/usr/bin/python3 /home/ubuntu/prometheus-retention/custom_metrics.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
