[Unit]
Description=Prometheus Intensive Metrics Generator 2
After=network-online.target

[Service]
User=ubuntu
Group=ubuntu
Type=simple
ExecStart=/usr/bin/python3 /home/ubuntu/prometheus-retention/intensive_metrics.py 8082 generator-2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
