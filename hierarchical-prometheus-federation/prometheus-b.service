[Unit]
Description=Prometheus - Cluster B
Wants=network-online.target
After=network-online.target node-exporter-b.service

[Service]
User=prometheus
Group=prometheus
Type=simple

ExecStart=/usr/local/bin/prometheus \
  --config.file=/etc/prometheus/cluster-b/prometheus.yml \
  --storage.tsdb.path=/var/lib/prometheus/cluster-b \
  --web.listen-address=127.0.0.1:9091 \
  --web.enable-lifecycle

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/prometheus/cluster-b

[Install]
WantedBy=multi-user.target
