[Unit]
Description=Prometheus Custom Metrics Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/prometheus-custom-metrics

ExecStart=/home/ubuntu/prometheus-custom-metrics/.venv/bin/python \
  /home/ubuntu/prometheus-custom-metrics/sample_app.py

Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
